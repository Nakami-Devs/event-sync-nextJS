// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Speaker {
  id             String           @id @default(uuid())
  full_name      String
  profile_pic    String
  biography      String
  external_links String
  sessions       SessionSpeaker[]

  @@map("speaker")
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String

  @@map("admin")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  start_date  DateTime
  end_date    DateTime
  place       String
  sessions    Session[]

  @@map("event")
}

model Room {
  id       String    @id @default(uuid())
  name     String
  capacity Int @default(0)
  sessions Session[]

  @@map("room")
}

model Session {
  id          String           @id @default(uuid())
  title       String
  description String
  start_time  DateTime
  end_time    DateTime
  id_event    String
  id_room     String
  event       Event            @relation(fields: [id_event], references: [id])
  room        Room             @relation(fields: [id_room], references: [id])
  speakers    SessionSpeaker[]
  questions   Question[]

  @@map("session")
}

model Question {
  id                String   @id @default(uuid())
  content           String
  name              String   @default("ANONYM")
  upvote_numbers    Int      @default(0)
  creation_datetime DateTime @default(now())
  id_session        String
  session           Session  @relation(fields: [id_session], references: [id])

  @@map("question")
}

model SessionSpeaker {
  id_speaker String
  id_session String
  speaker    Speaker @relation(fields: [id_speaker], references: [id])
  session    Session @relation(fields: [id_session], references: [id])

  @@id([id_speaker, id_session])
  @@map("session_speaker")
}
